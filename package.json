{
  "name": "wayfinder",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch dist/server/index.js",
    "build": "node ui/build.mjs && tsc -p tsconfig.json",
    "build:ui": "node ui/build.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "pretest": "npm run build:ui",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p ui/tsconfig.json",
    "lint": "eslint .",
    "adapters:conformance": "node scripts/adapters-conformance.mjs",
    "verify:bedrock": "node scripts/verify-bedrock.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1136.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
